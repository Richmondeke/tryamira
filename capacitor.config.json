{
  "appId": "com.amira.apple",
  "appName": "Amira",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://heyamira.com",
    "cleartext": false,
    "allowNavigation": [
      "heyamira.com",
      "*.heyamira.com",
      "api.vapi.ai",
      "*.vapi.ai",
      "checkout.flutterwave.com",
      "*.supabase.co"
    ]
  },
  "ios": {
    "scheme": "Amira",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#061b31",
      "showSpinner": false
    }
  }
}
