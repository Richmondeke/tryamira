# ==============================================================================
# AMIRA AI PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your staging/production keys:
#   cp .env.example .env.local
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="https://heyamira.com"

# Supabase Database & Authentication
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Vapi AI Voice Telephony
NEXT_PUBLIC_VAPI_PUBLIC_KEY="your-vapi-public-key"
NEXT_PUBLIC_VAPI_ASSISTANT_ID="your-vapi-assistant-id"
VAPI_PRIVATE_API_KEY="your-vapi-private-api-key"

# Composio Tool & OAuth Integration Platform (1,000+ Apps)
COMPOSIO_API_KEY="your-composio-api-key"

# Google Gemini AI LLM Intelligence
GEMINI_API_KEY="your-gemini-api-key"

# Resend Transactional & Executive Briefing Emails
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Amira Intelligence <onboarding@resend.dev>"

# Apify Actor Lead Sourcing Pipeline
APIFY_API_KEY="your-apify-api-key"
APIFY_ACTOR_ID="IoSHqwTR9YGhzccez"
APIFY_ACTOR_NAME="code_crafter/leads-finder"

# Korapay African & International Payment Gateway
KORAPAY_SECRET_KEY="sk_test_your_korapay_secret_key"

# Flutterwave Payment Gateway (v4 Charges & Webhooks)
FLUTTERWAVE_CLIENT_ID="your-flutterwave-client-id"
FLUTTERWAVE_CLIENT_SECRET="your-flutterwave-client-secret"
FLUTTERWAVE_ENCRYPTION_KEY="your-flutterwave-encryption-key"
FLUTTERWAVE_SECRET_HASH="your-flutterwave-webhook-secret-hash"
FLUTTERWAVE_SECRET_KEY="FLWSECK-your-flutterwave-secret-key"

# Scheduled Cron Trigger Authentication
CRON_SECRET="your-cron-secret-token"

# Optional Sentry Error Monitoring & Observability
NEXT_PUBLIC_SENTRY_DSN=""
